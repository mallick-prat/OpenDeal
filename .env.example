# =============================================================================
# Copy this file to .env.local and fill it in. Never commit .env.local.
# Required for a working install: the "REQUIRED" block. Everything else is
# optional and the app degrades gracefully without it.
# Full walkthrough: docs/SETUP.md
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase "Transaction pooler", Neon, or any
# Postgres 14+). Local example: postgres://localhost:5432/opendeal
DATABASE_URL=
# Session signing key. Generate: openssl rand -base64 32
AUTH_SECRET=
# Where the app lives (no trailing slash). Local: http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# The first admin. `npm run db:setup` creates this user; the app has no
# public signup, so nobody can sign in without a row in app_users.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_NAME=

# ── MAKE IT YOURS (no code changes needed) ───────────────────────────────────
NEXT_PUBLIC_ORG_NAME=Your Fund
# Comma-separated email domains of YOUR team ("internal" people are never
# mistaken for founders): yourfund.com,yourfund.vc
NEXT_PUBLIC_TEAM_DOMAINS=example.com
NEXT_PUBLIC_TIMEZONE=America/New_York
# Quote the hex in .env files: an unquoted # starts a comment and is silently ignored.
NEXT_PUBLIC_BRAND_COLOR="#0f62fe"
# More (pipeline stage names, tag label): src/config/crm.config.ts

# ── SIGN-IN ──────────────────────────────────────────────────────────────────
# Emailed 6-digit codes + invite links. Without a key, codes are printed to
# the server console in development, which is enough for local use.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend. The default works
# only for sending to your own Resend account email.
EMAIL_FROM=Your Fund <onboarding@resend.dev>
# "Continue with Google" button (also needed for Calendar/Gmail features).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── SCHEDULED JOBS (production) ──────────────────────────────────────────────
# Vercel sends this automatically to the cron routes in vercel.json.
# Must be 16+ characters. Generate: openssl rand -hex 24
CRON_SECRET=

# ── AI (optional) ────────────────────────────────────────────────────────────
# Parses inbound pitches/decks and drafts pass notes.
ANTHROPIC_API_KEY=
# INBOUND_MODEL=
# PASS_MODEL=
# Optional web research for founder lookups.
PERPLEXITY_API_KEY=

# ── FILE STORAGE (optional; needed to attach files to deals) ─────────────────
# Supabase project URL + service-role key (server only, never NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── INBOUND MAILBOX (optional) ───────────────────────────────────────────────
# A shared Gmail address (deals@yourfund.com) founders email pitches to.
# Connect it in Settings after setting this and redeploying.
NEXT_PUBLIC_INBOUND_MAILBOX=
# Webhook alternative via Resend inbound; token is part of the webhook URL.
# INBOUND_WEBHOOK_SECRET=
# Real-time Gmail push (otherwise the daily cron + "Poll now" are used):
# GMAIL_PUBSUB_TOPIC=projects/<gcp-project>/topics/<topic>
# INBOUND_PUSH_SECRET=
# DocSend conversion needs the docsend-to-pdf CLI on PATH (not on Vercel):
# DOCSEND_TO_PDF_CMD=docsend-to-pdf
# DOCSEND_VIEWER_EMAIL=

# ── GRANOLA MEETING NOTES (optional) ─────────────────────────────────────────
GRANOLA_API_KEY=

# ── ADVANCED ─────────────────────────────────────────────────────────────────
# APP_URL=                 links in emails (defaults to AUTH_URL)
# DATABASE_SSL=disable     force TLS off/on ("require"); default: on for remote hosts
# GOOGLE_SEARCH_KEY= / GOOGLE_SEARCH_CX=   LinkedIn lookup via Google CSE
